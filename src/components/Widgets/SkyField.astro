---
// Two-tone starfield background (src/scripts/sky). Dark mode only.
// The canvas persists across ClientRouter navigations; the palette is
// picked at random on each visit, and #sky-button (in Button.astro) changes it.
---

<canvas
  id="sky-field"
  class="sky-field"
  aria-hidden="true"
  transition:persist="sky-field"
></canvas>

<style>
  .sky-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    display: none;
  }
  :global(html.dark) .sky-field {
    display: block;
  }
</style>

<script>
import type { SkyPalette } from '@/scripts/sky/palettes'
import type { SkyHandle } from '@/scripts/sky/sky'
import { randomPalette } from '@/scripts/sky/generate'
import { PRESETS } from '@/scripts/sky/palettes'
import { createSky } from '@/scripts/sky/sky'

const KEY = 'sky-palette'
let sky: SkyHandle | null = null
let skyCanvas: HTMLCanvasElement | null = null

function initial(): SkyPalette {
  // Every fresh visit gets a random preset, never the one shown last time.
  let lastName = ''
  try {
    lastName = JSON.parse(localStorage.getItem(KEY) ?? 'null')?.name ?? ''
  }
  catch {}
  const pool = PRESETS.filter(x => x.name !== lastName)
  const p = pool[Math.floor(Math.random() * pool.length)]
  localStorage.setItem(KEY, JSON.stringify(p))
  return p
}

let current = initial()

function label() {
  const btn = document.getElementById('sky-button')
  if (btn)
    btn.title = `换一片天空（当前：${current.name}）`
}

function next() {
  let p: SkyPalette
  if (Math.random() < 0.5) {
    const others = PRESETS.filter(x => x.name !== current.name)
    p = others[Math.floor(Math.random() * others.length)]
  }
  else {
    p = randomPalette()
  }
  current = p
  localStorage.setItem(KEY, JSON.stringify(p))
  sky?.setPalette(p)
  label()
  // Like this sky? Copy the line into src/scripts/sky/palettes.ts.
  // eslint-disable-next-line no-console -- logs the palette so a favourite can be copied into PRESETS
  console.info('[sky]', JSON.stringify(p))
}

function sync() {
  const canvas = document.getElementById('sky-field') as HTMLCanvasElement | null
  const isDark = document.documentElement.classList.contains('dark')
  // If navigation replaced the canvas, the old sky is drawing to a detached node: start over.
  if (sky && (!isDark || canvas !== skyCanvas)) {
    sky.destroy()
    sky = null
    skyCanvas = null
  }
  if (isDark && canvas && !sky) {
    sky = createSky(canvas, current)
    skyCanvas = canvas
  }
  label()
}

document.addEventListener('click', (e) => {
  if ((e.target as Element | null)?.closest?.('#sky-button'))
    next()
})
new MutationObserver(sync).observe(document.documentElement, {
  attributes: true,
  attributeFilter: ['class'],
})
document.addEventListener('astro:page-load', sync)
sync()
</script>
